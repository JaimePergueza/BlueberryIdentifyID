# Copy to .env.docker before running Docker Compose.
# Replace every CHANGE_ME value. Never commit the resulting .env.docker file.

APP_VERSION=local
APP_PORT=8080

POSTGRES_USER=blueberry
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=blueberry_microid

MAX_UPLOAD_SIZE_MB=20
AUTH_SESSION_TTL_HOURS=12
LOG_LEVEL=INFO
LOG_FORMAT=json

# Used only by the optional demo profile.
DEMO_ADMIN_USERNAME=admin-demo
DEMO_ADMIN_PASSWORD=CHANGE_ME_DEMO_ADMIN_PASSWORD
DEMO_SPECIALIST_USERNAME=especialista-demo
DEMO_SPECIALIST_PASSWORD=CHANGE_ME_DEMO_SPECIALIST_PASSWORD
